# CareBuddy SMS Configuration - Quick Test Setup

# For immediate testing, we'll use test mode first
VITE_PRODUCTION_MODE=false

# Test endpoint (this will work immediately)
VITE_SMS_API_KEY=test_key
VITE_SMS_API_ENDPOINT=https://httpbin.org/post

# Default phone number for testing
VITE_DEFAULT_PHONE_NUMBER=9913390910

# When you get real SMS credentials, replace with:
# VITE_SMS_API_KEY=your_real_api_key
# VITE_SMS_API_ENDPOINT=https://api.twilio.com/2010-04-01/Accounts/YOUR_SID/Messages.json
# VITE_PRODUCTION_MODE=true
